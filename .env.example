PORT=3000
APP_BASE_URL=http://localhost:3000

# Portal's own tables. Points at the same Supabase Postgres as the stock
# source (schema `portal`), but never write to the stock source's tables.
DATABASE_URL=postgres://usuario:clave@host:5432/postgres

# Google OAuth (new client, separate from any internal-Workspace client -
# distributors are external users, so the OAuth consent screen must allow
# accounts outside your Workspace domain).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A long random string used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-value

# Read-only view into the existing stock table (see docs/06 in the handoff -
# confirm real table/column names by inspection before setting these).
STOCK_TABLE=public.productos
STOCK_COLUMN_SKU=sku
STOCK_COLUMN_QTY=stock
STOCK_COLUMN_UPDATED_AT=updated_at
LOW_STOCK_THRESHOLD=10

# Legacy catalog bootstrap (one-time import). Never commit the real value -
# set only in your local shell or in Render's environment variables.
LEGACY_CATALOG_SOURCE_URL=
LEGACY_CATALOG_IMPORT_ENABLED=false
