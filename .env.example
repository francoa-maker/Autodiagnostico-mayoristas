PORT=3000
APP_BASE_URL=http://localhost:3000

# Portal's OWN database - products, prices (except PVP), users, quotes,
# audit. A Render-managed Postgres, fully separate from Supabase.
DATABASE_URL=postgres://usuario:clave@host:5432/autodiagnostico_portal

# Google OAuth (new client, separate from any internal-Workspace client -
# distributors are external users, so the OAuth consent screen must allow
# accounts outside your Workspace domain).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A long random string used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-value

# The EXISTING Supabase project - read-only, and ONLY for stock + PVP (both
# read live, per product, by normalized SKU). Never write here. This is a
# different database from DATABASE_URL above - src/stock/stockRepository.js
# merges the two in application code, it can't be a single SQL JOIN.
# Confirm real table/column names with scripts/inspect_supabase_stock.js
# before trusting these defaults.
STOCK_DATABASE_URL=postgres://usuario:clave@host:5432/postgres
STOCK_TABLE=public.productos
STOCK_COLUMN_SKU=sku
STOCK_COLUMN_QTY=stock
STOCK_COLUMN_UPDATED_AT=updated_at
STOCK_COLUMN_PVP=pvp
LOW_STOCK_THRESHOLD=10

# Legacy catalog bootstrap (one-time import of 1u/4u/8u only - PVP is never
# imported/stored, it always comes live from Supabase). Never commit the
# real value - set only in your local shell or in Render's environment
# variables.
LEGACY_CATALOG_SOURCE_URL=
LEGACY_CATALOG_IMPORT_ENABLED=false
